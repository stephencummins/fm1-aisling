# (AISLING, step 4) the Lead's new voices in their pieces: Burren and Connemara (the Fiddle), Aran (the Chanter),
# Blasket and Samhain (the Voice), three minutes of each from its start, no clipping
wait 300
expect piece 0
turn PRESET 1
wait 300
expect piece 1
peakreset
wav lead_1_burren.wav
wait 180000
wavstop
expect peak_db_max -0.5
turn PRESET 1
wait 300
expect piece 2
peakreset
wav lead_2_aran.wav
wait 180000
wavstop
expect peak_db_max -0.5
turn PRESET 2
wait 300
expect piece 4
peakreset
wav lead_4_blasket.wav
wait 180000
wavstop
expect peak_db_max -0.5
turn PRESET 1
wait 300
expect piece 5
peakreset
wav lead_5_samhain.wav
wait 180000
wavstop
expect peak_db_max -0.5
turn PRESET 1
wait 300
expect piece 6
peakreset
wav lead_6_connemara.wav
wait 180000
wavstop
expect peak_db_max -0.5
