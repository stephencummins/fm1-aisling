# AISLING's eight pieces, three minutes of each from its start (PRESETS turned a step each time), a shot each,
# no clipping: for the ear and tools/analyze_wav.py (levels, bands)
wait 300
expect piece 0
# Skellig
peakreset
wav pieces_0_skellig.wav
wait 180000
wavstop
expect peak_db_max -0.5
shot pieces_0_skellig.png
turn PRESET 1
wait 300
expect piece 1
# Burren
peakreset
wav pieces_1_burren.wav
wait 180000
wavstop
expect peak_db_max -0.5
shot pieces_1_burren.png
turn PRESET 1
wait 300
expect piece 2
# Aran
peakreset
wav pieces_2_aran.wav
wait 180000
wavstop
expect peak_db_max -0.5
shot pieces_2_aran.png
turn PRESET 1
wait 300
expect piece 3
